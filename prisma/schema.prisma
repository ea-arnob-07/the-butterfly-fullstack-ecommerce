generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
  PRODUCT_MANAGER
  ORDER_MANAGER
  SUPPORT
}

enum GenderSegment {
  WOMEN
  MEN
  CHILDREN
  UNISEX
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD
  MOBILE_BANKING
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryZone {
  INSIDE_DHAKA
  OUTSIDE_DHAKA
}

enum MobileBankingProvider {
  BKASH
  NAGAD
  ROCKET
}

enum OtpPurpose {
  EMAIL_VERIFICATION
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  phone        String?
  passwordHash String
  role         Role           @default(CUSTOMER)
  isActive     Boolean        @default(true)
  emailVerifiedAt DateTime?
  otpCodes     OtpCode[]
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlist     WishlistItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    OtpPurpose @default(EMAIL_VERIFICATION)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  fullName   String
  phone      String
  division   String
  district   String
  area       String
  postalCode String?
  address    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model ItemType {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  position  Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  segment     GenderSegment
  imageUrl    String?
  description String?
  isActive    Boolean       @default(true)
  position    Int           @default(0)
  products    Product[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Product {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  shortDescription String?
  description      String
  segment          GenderSegment
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id])
  itemTypeId       String?
  itemType         ItemType?       @relation(fields: [itemTypeId], references: [id], onDelete: SetNull)
  brand            String?         @default("The Butterfly")
  material         String?
  careInstructions String?
  basePrice        Decimal         @db.Decimal(10, 2)
  salePrice        Decimal?        @db.Decimal(10, 2)
  sku              String          @unique
  isFeatured       Boolean         @default(false)
  isNewArrival     Boolean         @default(false)
  isBestSeller     Boolean         @default(false)
  isPublished      Boolean         @default(true)
  deletedAt        DateTime?
  position         Int             @default(0)
  images           ProductImage[]
  variants         ProductVariant[]
  orderItems       OrderItem[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([segment, isPublished])
  @@index([categoryId])
  @@index([itemTypeId])
  @@index([isBestSeller, isPublished])
  @@index([isNewArrival, isPublished])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String
  sku       String   @unique
  stock     Int      @default(0)
  price     Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size, color])
  @@index([productId])
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  customerEmail   String
  customerPhone   String
  division        String
  district        String
  area            String
  postalCode      String?
  deliveryAddress String
  notes           String?
  subtotal        Decimal         @db.Decimal(10, 2)
  discount        Decimal         @default(0) @db.Decimal(10, 2)
  deliveryFee     Decimal         @default(0) @db.Decimal(10, 2)
  total           Decimal         @db.Decimal(10, 2)
  status          OrderStatus     @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus   @default(UNPAID)
  paymentReference String?
  deliveryZone    DeliveryZone    @default(OUTSIDE_DHAKA)
  mobileBankingProvider MobileBankingProvider?
  paymentSenderNumber String?
  paymentTransactionId String?    @unique
  paymentScreenshotUrl String?
  stripeSessionId String?         @unique
  stockDeducted   Boolean         @default(false)
  stockRestored   Boolean         @default(false)
  items           OrderItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([mobileBankingProvider])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  name      String
  imageUrl  String?
  size      String
  color     String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  total     Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model SiteSettings {
  id                 String   @id @default("main")
  siteName           String   @default("The Butterfly")
  tagline            String   @default("Your Dream Line")
  pageTitle          String   @default("The Butterfly | Your Dream Line")
  metaDescription    String   @default("Premium fashion for women, men, and children.")
  logoUrl            String   @default("/images/butterfly-logo-transparent.png")
  faviconUrl         String   @default("/images/butterfly-logo-transparent.png")
  heroImageUrl       String   @default("/images/butterfly-hero-4k.webp")
  heroEyebrow        String   @default("Luxury Fashion Destination")
  heroTitle          String   @default("Style curated")
  heroHighlight      String   @default("for every generation.")
  heroTagline        String   @default("The Butterfly — Your Dream Line")
  heroDescription    String   @default("Discover a refined online shopping experience where modern design, premium presentation, and confident style come together for every generation.")
  aboutDescription   String   @default("Premium fashion and accessories for women, men, and children with a polished shopping experience.")
  contactTitle       String   @default("We are here to help you shop with confidence.")
  contactDescription String   @default("Reach out for product enquiries, order support, collaboration discussions, or direct customer assistance.")
  phone              String   @default("+8801707845422")
  email              String   @default("butterflythe710@gmail.com")
  whatsappNumber     String   @default("8801707845422")
  facebookUrl        String   @default("https://www.facebook.com/profile.php?id=61581187327217&mibextid=wwXIfr&rdid=Cz2X2rMU9AlEPwy6&share_url=https%3A%2F%2Fwww.facebook.com%2Fshare%2F1BcduGXoHy%2F#")
  instagramUrl       String?
  deliveryText       String   @default("Inside Dhaka delivery ৳60 · Outside Dhaka ৳120")
  updatedAt          DateTime @updatedAt
}
